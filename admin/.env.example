# Copia questo file come "admin/.env" e compila i valori.
# Il file .env è escluso da git: NON va mai caricato su GitHub né copiato nei PC dei negozi.
#
# I valori si trovano su supabase.com → il tuo progetto → Project Settings → API Keys
# (vedi docs/GUIDA.md, passo "Chiavi del progetto").

# Indirizzo del progetto, es. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Chiave pubblica: "Publishable key" (sb_publishable_...) oppure la vecchia "anon" key.
# È la stessa che finisce nell'app: non è segreta.
SUPABASE_CHIAVE_PUBBLICA=

# Chiave SEGRETA: "Secret key" (sb_secret_...) oppure la vecchia "service_role" key.
# Dà pieno accesso al database: solo qui, mai nell'app, mai su GitHub.
SUPABASE_CHIAVE_SEGRETA=

# Dominio fittizio per le email interne degli account (es. pv01@contatti-interni.local).
# Non serve che esista: nessuna email viene mai inviata.
DOMINIO_EMAIL=contatti-interni.local
